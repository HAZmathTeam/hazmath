@PACKAGE_INIT@

# Provides the imported target hazmath::hazmath
include("${CMAKE_CURRENT_LIST_DIR}/hazmathTargets.cmake")

set(hazmath_LIBRARY_TYPE "@HAZMATH_LIBRARY_TYPE@")
# whether libhazmath is compiled with SuiteSparse (WITH_SUITESPARSE) and with
# LAPACK (WITH_LAPACK). New names: the hazmath_WITH_* of earlier configs
# followed SUITESPARSE_FOUND and LAPACK_FOUND, which can be TRUE without them.
set(hazmath_HAS_SUITESPARSE "@HAZMATH_WITH_SUITESPARSE@")
set(hazmath_HAS_LAPACK "@HAZMATH_WITH_LAPACK@")

# A static libhazmath exports the external libraries it was built with, by
# the paths found at that time
get_target_property(_hazmath_libs hazmath::hazmath INTERFACE_LINK_LIBRARIES)
foreach(_hazmath_lib IN LISTS _hazmath_libs)
  if(IS_ABSOLUTE "${_hazmath_lib}" AND NOT EXISTS "${_hazmath_lib}")
    set(hazmath_FOUND FALSE)
    set(hazmath_NOT_FOUND_MESSAGE
      "the static libhazmath was built with ${_hazmath_lib}, which does not exist")
    return()
  endif()
endforeach()

check_required_components(hazmath)
